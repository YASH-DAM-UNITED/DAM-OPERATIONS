{
  "name": "dam-operations",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "keep_vars": true,


  "vars": {
    "AZURE_VISION_ENDPOINT": "https://dam-operations-rg.cognitiveservices.azure.com/",
    "GLOR_MASTER_SHEET_ID": "1fKOtqdN_QlVNuHQujSlBKPJDk3n19zy1A4S1DwNCQro",
    "GLOR_MASTER_GID": "627415313",
    "MOOMA_MASTER_SHEET_ID": "1hG25yLn1kGRKpyjtbUmBEZfKjLeiSQvz6sKp9uBeD2w"
  },



  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },


  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dam-operations-db",
      "database_id": "4a828bb8-1811-4867-8c5e-0faaf618d810"
    }
  ]
}
